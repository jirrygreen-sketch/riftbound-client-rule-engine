{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Riftbound Desktop Client",
  "version": "0.1.0",
  "identifier": "com.riftbound.desktop-client",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Riftbound 桌面牌桌",
        "width": 1440,
        "height": 900,
        "minWidth": 1120,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "http:",
          "https:",
          "ws:",
          "wss:"
        ],
        "img-src": ["'self'", "http:", "https:"],
        "style-src": "'self'",
        "script-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "devCsp": {
        "default-src": "'self'",
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "http:",
          "https:",
          "ws:",
          "wss:"
        ],
        "img-src": ["'self'", "http:", "https:"],
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self' 'unsafe-inline'",
        "object-src": "'none'",
        "base-uri": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
