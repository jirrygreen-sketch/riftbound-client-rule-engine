{
  "name": "@riftbound/card-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@riftbound/card-dsl": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sync:cards": "pnpm build && node scripts/sync-current-cards.mjs",
    "sync:community-cards": "pnpm build && node scripts/sync-cards.mjs",
    "sync:images": "node scripts/sync-images.mjs",
    "build:catalog": "node scripts/build-deck-catalog.mjs",
    "build:coverage": "pnpm build && node scripts/build-effect-coverage.mjs",
    "audit:catalog": "pnpm build && node --test test/persisted-catalog-audit.mjs",
    "verify:rule-sources": "node scripts/verify-rule-sources.mjs",
    "verify:rule-sources:manifest-only": "node scripts/verify-rule-sources.mjs --manifest-only",
    "test": "tsc -p tsconfig.json && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
