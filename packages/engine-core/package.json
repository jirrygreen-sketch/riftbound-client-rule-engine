{
  "name": "@riftbound/engine-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./experimental": {
      "types": "./dist/full-product/runtime.d.ts",
      "default": "./dist/full-product/runtime.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @riftbound/protocol build && pnpm build && node --test test/*.test.mjs test/full-product/*.test.mjs"
  },
  "dependencies": {
    "@riftbound/protocol": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
