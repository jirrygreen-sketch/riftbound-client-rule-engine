{
  "name": "@riftbound/card-dsl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./duel": {
      "types": "./dist/duel/index.d.ts",
      "default": "./dist/duel/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "node ../../scripts/gen-registries.mjs",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "node ../../scripts/gen-registries.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "node ../../scripts/gen-registries.mjs",
    "test": "pnpm build && node --test test/*.test.mjs test/full-product/*.test.mjs test/duel/*.test.mjs",
    "audit:official-catalog": "pnpm build && node --test test/duel/*.audit.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
